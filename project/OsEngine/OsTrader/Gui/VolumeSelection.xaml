<Window x:Class="OsEngine.OsTrader.Gui.VolumeSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OsEngine.OsTrader.Gui"
        mc:Ignorable="d"
        Title="Volume Selection" Height="80" Width="300" Style="{StaticResource WindowStyleCanResize}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <ComboBox Name="ComboBoxPortfolio" HorizontalAlignment="Left" Margin="10,10,10,10" VerticalAlignment="Top" Width="150" Height="22" Grid.Column="0"/>
        <Button x:Name="bOk" Width="60" Height="25" Click="bOk_Click" Content="Ok" Grid.Column="1" Margin="10,10,10,10" VerticalAlignment="Top"/>
    </Grid>
</Window>
