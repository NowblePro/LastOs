        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OsEngine.OsOptimizer.Gui"
        mc:Ignorable="d"
        Title="Загрузка фаз" Height="100" Width="400"  Style="{StaticResource WindowStyleCanResize}">
