<Window x:Class="OsEngine.OsOptimizer.Gui.PhazePresetSaver"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OsEngine.OsOptimizer.Gui"
        mc:Ignorable="d"
        Title="Сохранение фаз" Height="150" Width="300" Style="{StaticResource WindowStyleCanResize}">
    <Grid>
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">Название: </Label>
        <TextBox Name="TextBoxPhazePresetName" HorizontalAlignment="Left" Height="23" Margin="100,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="141"/>
        <Button Name="ButtonPhazePresetSave" Content="Сохранить" Margin="50,50,10,10" VerticalAlignment="Top" HorizontalAlignment="Left" Width="142" Click="ButtonPhazePresetSave_Click"/>
    </Grid>
</Window>
